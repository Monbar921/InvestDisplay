<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-create-asset-snapshot-table" author="d.v.kornilovich">
        <createTable tableName="asset_snapshot">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>

            <column name="asset_id" type="bigint">
                <constraints foreignKeyName="fk_asset_snapshot_asset_id" references="asset(id)"
                             nullable="false"/>
            </column>

            <column name="value" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamp"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
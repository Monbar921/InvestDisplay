<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-transaction-category-table" author="d.v.kornilovich">
        <preConditions>
            <not>
                <tableExists tableName="transaction_category"/>
            </not>
        </preConditions>

        <createTable tableName="transaction_category">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="transaction_id" type="bigint">
                <constraints foreignKeyName="fk_transaction_category_transaction_id" references="transaction(id)"
                             nullable="false"/>
            </column>
            <column name="category_id" type="bigint">
                <constraints foreignKeyName="fk_transaction_category_category_id" references="category(id)"
                             nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-user-category-table" author="d.v.kornilovich">
        <preConditions>
            <not>
                <tableExists tableName="user_category"/>
            </not>
        </preConditions>

        <createTable tableName="user_category">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints foreignKeyName="fk_user_category_user_id" references="user(id)"
                             nullable="false"/>
            </column>
            <column name="name" type="varchar(100)"/>
            <column name="created_at" type="timestamp"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>
</databaseChangeLog>